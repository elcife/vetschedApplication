<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_profile_card"
    android:orientation="vertical"
    android:paddingHorizontal="14dp">

    <LinearLayout
        android:id="@+id/faqHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/faqQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="12dp"
            android:textColor="@color/vetsched_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/faqChevron"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⌄"
            android:textColor="@color/vetsched_text_primary"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/faqAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/vetsched_text_hint"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
